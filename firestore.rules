rules_version = '2';
// Regles de Firestore per a «Les peces del ferrer».
// Publica-les a Firebase Console → Firestore Database → Regles (copia i enganxa tot el fitxer).
service cloud.firestore {
  match /databases/{database}/documents {

    // Tenir sessió no vol dir tenir permís: a Firebase qualsevol es pot crear un compte.
    // Per això cap regla es refia de «request.auth != null»; només compten aquests dos comptes.
    function isEditor() {
      return request.auth != null && request.auth.token.email == 'editor@escultures.app';
    }
    // Lectura: l'editor i el compte de només lectura (lectura@escultures.app).
    function isReader() {
      return request.auth != null &&
        request.auth.token.email in ['editor@escultures.app', 'lectura@escultures.app'];
    }

    // Fitxes: catàleg públic (escaparate). Qualsevol pot veure-les sense contrasenya; per això la ubicació,
    // la propietat, les observacions i la situació NO hi són: es desen a «intern».
    // IMPORTANT: publicar aquesta regla només DESPRÉS d'haver fet «Administració → Dades internes» a l'app.
    match /inventari/{doc} {
      allow get: if true;
      allow list: if true;
      allow write: if isEditor();
    }

    // Dades internes de cada peça (ubicació, propietat, observacions i situació): només amb contrasenya.
    match /intern/{doc} {
      allow read: if isReader();
      allow write: if isEditor();
    }

    // Fotos de detall: igual que les fitxes.
    match /fotos/{doc} {
      allow get: if true;
      allow list: if isReader();
      allow write: if isEditor();
    }

    // Dades privades (valor / assegurança): només l'editor.
    match /privat/{doc} {
      allow read, write: if isEditor();
    }

    // Historial: només l'editor el llegeix, hi escriu i pot esborrar-lo.
    match /historial/{doc} {
      allow read, write: if isEditor();
    }

    // Històries aprovades: igual que les fitxes; només l'editor les publica o esborra.
    match /histories/{doc} {
      allow get: if true;
      allow list: if isReader();
      allow write: if isEditor();
    }

    // Històries proposades des de l'accés de lectura: només en poden crear, pendents d'aprovació.
    // Cal sessió (editor o lectura): sense contrasenya no es pot enviar res.
    // La data ha de ser l'actual (±10 min): no es poden enviar tandes amb dates inventades.
    match /propostes/{doc} {
      allow read, update, delete: if isEditor();
      allow create: if isEditor() || (isReader() &&
        request.resource.data.keys().hasOnly(['n', 'tipus', 'text', 'autor', 'ts']) &&
        request.resource.data.n is int && request.resource.data.n > 0 &&
        request.resource.data.tipus in ['anecdota', 'autoria', 'encarrec', 'comentari'] &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 2 && request.resource.data.text.size() <= 2000 &&
        request.resource.data.autor is string && request.resource.data.autor.size() <= 60 &&
        request.resource.data.ts is int &&
        request.resource.data.ts > request.time.toMillis() - 600000 &&
        request.resource.data.ts < request.time.toMillis() + 600000
      );
    }

    // Suggeriments: es poden enviar amb sessió (editor o lectura); només l'editor els llegeix i gestiona.
    match /suggeriments/{doc} {
      allow read, update, delete: if isEditor();
      allow create: if isEditor() || (isReader() &&
        request.resource.data.keys().hasOnly(['text', 'nom', 'estat', 'ts']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 1500 &&
        request.resource.data.nom is string && request.resource.data.nom.size() <= 60 &&
        request.resource.data.estat == 'pendent' &&
        request.resource.data.ts is int &&
        request.resource.data.ts > request.time.toMillis() - 600000 &&
        request.resource.data.ts < request.time.toMillis() + 600000
      );
    }

    // Gestió: només l'editor.
    match /revisio/{doc}        { allow read, write: if isEditor(); }   // revisió d'inventari
    match /prestecs/{doc}       { allow read, write: if isEditor(); }
    match /restauracions/{doc}  { allow read, write: if isEditor(); }
    match /documents/{doc}      { allow read, write: if isEditor(); }   // certificats, factures, taxacions
    match /docdata/{doc}        { allow read, write: if isEditor(); }   // contingut dels documents
  }
}
